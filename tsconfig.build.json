{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": false
  },
  "include": ["src/**/*.ts", "prisma/generated/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "prisma/seed.ts", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
